# ============================================================================
# Flow CMMS - Variáveis de Ambiente (.env.example)
# ============================================================================

# Dados do Banco de Dados PostgreSQL Central
CMMS_DB_NAME=flow_cmms_db
CMMS_DB_USER=flow_cmms_user
CMMS_DB_PASSWORD=cmms_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL de Conexão com o Banco de Dados (Substitua as credenciais se alterar no banco)
DATABASE_URL=postgresql://flow_cmms_user:cmms_dev_password@postgres:5432/flow_cmms_db

# Chave Secreta para Assinatura de Tokens JWT (Substitua em Produção por uma string forte)
SECRET_KEY=change-this-secret-key-before-production-flow-cmms-2026

# Ambiente da Aplicação (production / development)
APP_ENV=production

# Integrações de IA (Opcional)
AI_PROVIDER=gemini
AI_API_KEY=
