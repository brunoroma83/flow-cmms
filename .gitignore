# ============================================================================
# Git Ignore - Flow CMMS
# ============================================================================

# Environment Variables & Credentials (CRITICAL - DO NOT COMMIT)
.env
.env.local
.env.*.local

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.nox/
.tox/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Scratch Files
*.log
logs/
scratch/
tmp/

# Node.js & Web Assets (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
